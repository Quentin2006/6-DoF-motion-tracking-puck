# Editor IntelliSense only — this file does not compile or flash anything.
#
# Every toolchain path lives in the repo-root compile_commands.json, which
# `make lsp` generates from arduino-cli's real command line (it also injects
# the --sysroot the xtensa headers need). Nothing here hardcodes a path, so
# this file works for every contributor; run `make lsp` first.
#
# NOTE: .ino language is forced via compile_commands.json (-x c++ injected
# by `make lsp`); no PathMatch block needed here.
CompileFlags:
  Remove: [-m*, -f*]
